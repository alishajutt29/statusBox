
<div class="todos-page">

  <header class="todos-header">
    <div>
      <p class="eyebrow">YOUR WORKSPACE</p>
      <h1>My Todos</h1>
      <p class="todos-subtitle">Manage your tasks in one place.</p>
    </div>

    <%= link_to "+ New Todo", new_todo_path, class: "primary-btn" %>
  </header>

  <% sections = [
    ["Pending", @pending_todos, "pending"],
    ["Completed", @completed_todos, "completed"],
    ["Cancelled", @cancelled_todos, "cancelled"]
  ] %>

  <% sections.each do |heading, todos, status| %>
    <section class="todo-section">
      <div class="todo-section-heading">
        <h2><%= heading %></h2>
        <span class="section-count"><%= todos.count %></span>
      </div>

      <% if todos.any? %>
        <div class="todo-grid">
          <% todos.each do |todo| %>
            <div class="todo-card">
              <div class="todo-card-top">
                <span class="status-badge <%= status %>">
                  <%= status.capitalize %>
                </span>
              </div>

              <h3><%= link_to todo.title, todo_path(todo) %></h3>
              <p class="todo-description">
                <%= todo.description.presence || "No description added." %>
              </p>

              <div class="todo-actions">
                <% if status == "pending" %>
                  <%= button_to "Complete", complete_todo_path(todo), method: :patch, class: "action-btn dark-action" %>
                  <%= button_to "Cancel", cancel_todo_path(todo), method: :patch, class: "action-btn" %>
                  <%= link_to "Edit", edit_todo_path(todo), class: "action-btn" %>
                  <%= button_to "Delete", todo_path(todo), method: :delete, class: "action-btn" %>
                <% else %>
                  <%= button_to "Restore", restore_todo_path(todo), method: :patch, class: "action-btn dark-action" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="todo-empty">
          No <%= heading.downcase %> tasks yet.
        </div>
      <% end %>
    </section>
  <% end %>

</div>
